{
  "name": "@maverick18722/tombstone",
  "version": "0.1.0",
  "type": "module",
  "description": "Utility to help assist in managing code that is slated for deprecation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "prepack": "tsc --project tsconfig.build.json",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maverick1872/tombstone.git"
  },
  "keywords": [
    "deprecation",
    "observability",
    "monitoring",
    "maintenance",
    "opentelemetry",
    "telemetry"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maverick1872/tombstone/issues"
  },
  "homepage": "https://github.com/maverick1872/tombstone#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^24.3.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  }
}
